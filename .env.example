# Copy to .env.local and fill in. All values are server-only.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-google-app-password
LEAD_NOTIFY_TO=owner1@example.com,owner2@example.com
OWNER_PASSWORD=choose-a-long-password-for-/leads-owner
SESSION_SECRET=run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Optional: sender name shown in inboxes (default "Trivian AI Solutions")
MAIL_FROM_NAME=Trivian AI Solutions
# Optional: website links in emails — only once the site is live
SITE_LIVE_URL=https://trivianaisolutions.in

# ── Better inbox placement: send from your own domain (recommended) ──
# When SMTP_HOST is set, mail is sent through it instead of Gmail. Example for Resend
# (verify trivianaisolutions.in in Resend first; it gives you the DNS records):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# MAIL_FROM_ADDRESS=hello@trivianaisolutions.in

# Lead storage on Vercel: add Upstash Redis (Vercel → Storage). These are filled in automatically.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
